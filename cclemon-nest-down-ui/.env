# === Server-only (不暴露給 client) ===

# OIDC / PKCE 設定
NUXT_OIDC_DISCOVERY_URL=http://localhost:9000/.well-known/openid-configuration
NUXT_OIDC_CLIENT_ID=nest-down-ui
NUXT_OIDC_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
NUXT_OIDC_SCOPE=openid profile email offline_access
NUXT_OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:3000/auth/login

# API Gateway URL（取代舊 NestJS 直連）
NUXT_API_GATEWAY_URL=http://127.0.0.1:8080

# Session 加密 secret（production 請換成強隨機值）
NUXT_SESSION_SECRET=dev-secret-change-in-productions
